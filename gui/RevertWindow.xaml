<Window x:Class="BoitHardenHome.RevertWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vrátit změny" Height="520" Width="640"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource bBg}" Foreground="{StaticResource bText}" FontFamily="Segoe UI">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="Vrátit provedené změny" FontSize="18" FontWeight="Bold"/>
            <TextBlock Text="Vyberte běh, který chcete vrátit. Vše se obnoví přesně do stavu před změnou."
                       Foreground="{StaticResource bMut}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"/>
        </StackPanel>

        <Border Grid.Row="1" BorderBrush="{StaticResource bLine}" BorderThickness="1">
            <ListBox x:Name="RunsList" Background="{StaticResource bCard}" BorderThickness="0" Foreground="{StaticResource bText}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="6,8">
                            <TextBlock Text="{Binding Header}" FontWeight="SemiBold" FontSize="14"/>
                            <TextBlock Text="{Binding Sub}" Foreground="{StaticResource bMut}" FontSize="12" Margin="0,2,0,0"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Zavřít" Style="{StaticResource GhostButton}" Margin="0,0,10,0" Click="Close_Click"/>
            <Button Content="Vrátit vybraný běh" Style="{StaticResource PrimaryButton}" Click="Revert_Click"/>
        </StackPanel>
    </Grid>
</Window>
