<Window x:Class="BoitHardenHome.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BOIT Harden Home" Height="820" Width="1040"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource bBg}"
        FontFamily="Segoe UI" Foreground="{StaticResource bText}">

    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- header -->
            <RowDefinition Height="Auto"/>  <!-- toolbar -->
            <RowDefinition Height="*"/>     <!-- list -->
            <RowDefinition Height="Auto"/>  <!-- footer -->
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" Background="{StaticResource bCard}" BorderBrush="{StaticResource bLine}" BorderThickness="0,0,0,1" Padding="24,18">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="BOIT" FontSize="22" FontWeight="Bold" Foreground="{StaticResource bLime}" FontFamily="Consolas"/>
                    <TextBlock Text="  Harden Home" FontSize="22" FontWeight="Bold" FontFamily="Consolas"/>
                </StackPanel>
                <TextBlock Margin="0,4,0,0" Foreground="{StaticResource bMut}" FontSize="13"
                           Text="Zkontroluje bezpečnost a soukromí vašeho Windows a navrhne, co vylepšit. Nic se nestane bez vašeho souhlasu – a kdykoli to jde vrátit zpět."/>
            </StackPanel>
        </Border>

        <!-- TOOLBAR -->
        <Border Grid.Row="1" Background="{StaticResource bCard2}" Padding="24,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Rozsah:" VerticalAlignment="Center" Foreground="{StaticResource bMut}" Margin="0,0,10,0"/>
                    <ComboBox x:Name="TierCombo" Width="220" SelectedIndex="0" SelectionChanged="TierCombo_Changed"
                              VerticalContentAlignment="Center" Height="34">
                        <ComboBoxItem Content="Jen bezpečné změny"/>
                        <ComboBoxItem Content="Bezpečné + střední"/>
                        <ComboBoxItem Content="Vše (včetně agresivních)"/>
                    </ComboBox>
                    <Button Content="Vybrat vše" Style="{StaticResource GhostButton}" Margin="12,0,0,0" Click="SelectAll_Click"/>
                    <Button Content="Zrušit výběr" Style="{StaticResource GhostButton}" Margin="8,0,0,0" Click="SelectNone_Click"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Content="Vrátit změny…" Style="{StaticResource GhostButton}" Margin="0,0,10,0" Click="Revert_Click"/>
                    <Button x:Name="ApplyBtn" Content="Použít vybrané" Style="{StaticResource PrimaryButton}" Click="Apply_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- STATS + LIST -->
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="24,16,24,8">
                <Border Background="{StaticResource bCard}" BorderBrush="{StaticResource bLine}" BorderThickness="1" Padding="16,10" Margin="0,0,12,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="OkCount" Text="0" FontSize="20" FontWeight="Bold" Foreground="{StaticResource bLime}" FontFamily="Consolas"/>
                        <TextBlock Text="  v pořádku" VerticalAlignment="Center" Foreground="{StaticResource bMut}"/>
                    </StackPanel>
                </Border>
                <Border Background="{StaticResource bCard}" BorderBrush="{StaticResource bLine}" BorderThickness="1" Padding="16,10">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="FixCount" Text="0" FontSize="20" FontWeight="Bold" Foreground="#FFFF5A5A" FontFamily="Consolas"/>
                        <TextBlock Text="  k nápravě" VerticalAlignment="Center" Foreground="{StaticResource bMut}"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,0,24,16">
                <ItemsControl x:Name="List">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource bCard}" BorderBrush="{StaticResource bLine}" BorderThickness="1"
                                    Margin="0,0,0,10" Padding="16,14" Opacity="{Binding RowOpacity}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                              Visibility="{Binding CheckVisibility}" VerticalAlignment="Top"
                                              Margin="0,2,14,0"/>

                                    <StackPanel Grid.Column="1">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Category}" FontSize="11" Foreground="{StaticResource bMut}"
                                                       FontFamily="Consolas"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding Desc}" FontSize="13" Foreground="#FFCFD4DA" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding Why}" FontSize="12" Foreground="{StaticResource bMut}" FontStyle="Italic" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" HorizontalAlignment="Right" Margin="16,0,0,0">
                                        <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusBrush}"
                                                   FontWeight="Bold" FontFamily="Consolas" FontSize="12" HorizontalAlignment="Right"/>
                                        <Border Margin="0,8,0,0" BorderBrush="{Binding RiskBrush}" BorderThickness="1" Padding="8,2" HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding RiskLabel}" Foreground="{Binding RiskBrush}" FontSize="10" FontFamily="Consolas"/>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <!-- FOOTER -->
        <Border Grid.Row="3" Background="{StaticResource bCard}" BorderBrush="{StaticResource bLine}" BorderThickness="0,1,0,0" Padding="24,12">
            <Grid>
                <TextBlock x:Name="StatusBar" VerticalAlignment="Center" Foreground="{StaticResource bMut}" FontSize="12"
                           Text="Připraveno."/>
                <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="12">
                    <Run Text="Děláme " Foreground="{StaticResource bMut}"/><Run Text="#BezpečnějšíČesko" Foreground="{StaticResource bLime}" FontWeight="Bold"/>
                </TextBlock>
            </Grid>
        </Border>
    </Grid>
</Window>
